MCP_DOMAIN=mcp.example.com
MCP_LOGIN_EMAIL=owner@example.com
# Optional. Leave unset to have the server generate a password and print it once in its logs.
# To choose your own, generate a hash with geekbi-password-hash and keep the single quotes.
# MCP_PASSWORD_HASH='replace-with-generated-scrypt-hash'
MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
GEEKBI_REQUEST_TIMEOUT=30
